# Flask Core Configuration
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Security Keys (Generate strong 64-char key in production, e.g. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-secure-random-64-character-hex-key-in-production

# Session & Cookie Security (Set to 1 / True when running behind HTTPS/SSL)
SESSION_COOKIE_SECURE=0

# Initial Default Administrator Setup
ADMIN_EMAIL=admin@cityos.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password-in-production

# Database Configuration (Defaults to SQLite instance/cityos.db)
DATABASE_PATH=instance/cityos.db
